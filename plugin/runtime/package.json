{
  "name": "@bypass-labs/cli-skeleton",
  "version": "0.2.1",
  "private": true,
  "description": "Bypass POC: shared-model Docker agents, scoped HTTP proof, and deterministic security regressions.",
  "type": "module",
  "bin": {
    "bypass": "bin/bypass.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/bypass.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node bin/bypass.mjs demo",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:validate": "MUSE_NO_AUTO_UPDATE=1 muse plugins validate plugin --json"
  }
}
