{
  "name": "@bypass-labs/cli-skeleton",
  "version": "0.1.0",
  "private": true,
  "description": "Runnable Bypass journey: real onboarding and regression replay, explicitly simulated analysis engines.",
  "type": "module",
  "bin": { "bypass": "bin/bypass.mjs" },
  "engines": { "node": ">=22" },
  "scripts": {
    "start": "node bin/bypass.mjs",
    "test": "node --test test/*.test.mjs",
    "check": "node scripts/check.mjs",
    "demo": "node bin/bypass.mjs demo start",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:validate": "MUSE_NO_AUTO_UPDATE=1 muse plugins validate plugin --json"
  }
}
