{
  "schemaVersion": 1,
  "name": "bypass",
  "displayName": "Bypass for Muse Code",
  "version": "0.7.7",
  "description": "Security-testing plugin for Muse Code: review source, test authorized running apps, save regression checks, and reuse security context while building.",
  "compat": {
    "source": "native",
    "manifestDir": ".muse-plugin"
  },
  "capabilities": {
    "skills": [
      {
        "id": "bypass",
        "path": "skills/bypass/SKILL.md",
        "enabledDefault": true
      }
    ],
    "commands": [
      {
        "id": "start",
        "path": "commands/start.md"
      },
      {
        "id": "demo",
        "path": "commands/demo.md"
      },
      {
        "id": "status",
        "path": "commands/status.md"
      },
      {
        "id": "review",
        "path": "commands/review.md"
      },
      {
        "id": "blackbox",
        "path": "commands/blackbox.md"
      },
      {
        "id": "tests",
        "path": "commands/tests.md"
      },
      {
        "id": "monitor",
        "path": "commands/monitor.md"
      },
      {
        "id": "build",
        "path": "commands/build.md"
      },
      {
        "id": "context",
        "path": "commands/context.md"
      },
      {
        "id": "help",
        "path": "commands/help.md"
      },
      {
        "id": "discover",
        "path": "commands/discover.md"
      }
    ],
    "mcpServers": [
      {
        "id": "security",
        "transport": "stdio",
        "command": [
          "node",
          "mcp/server.mjs"
        ]
      }
    ],
    "hooks": [
      {
        "id": "session-context",
        "event": "SessionStart",
        "command": [
          "node",
          "mcp/context-hook.mjs"
        ],
        "timeoutMs": 3000,
        "statusMessage": "Checking Bypass application selection"
      }
    ]
  }
}
