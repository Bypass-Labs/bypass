{
  "name": "@bypass-labs/bypass",
  "version": "0.7.7",
  "private": true,
  "description": "Security-testing plugin for Muse Code: source review, live app testing, saved regressions, and security memory. Also available as a standalone CLI.",
  "type": "module",
  "bin": {
    "bypass": "bin/bypass.mjs"
  },
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node bin/bypass.mjs",
    "test": "node --import ./test/legacy-muse-env.mjs --test --test-concurrency=1 test/*.test.mjs",
    "test:scanner": "node scripts/test-scanner.mjs",
    "test:codeql": "node scripts/codeql-smoke.mjs && node scripts/codeql-boundaries.mjs && node scripts/codeql-scope-smoke.mjs && node scripts/policy-smoke.mjs --combined",
    "check": "node scripts/check.mjs && node scripts/check-plugin-parity.mjs",
    "demo": "node bin/bypass.mjs demo",
    "plugin:build": "node scripts/build-plugin.mjs",
    "plugin:validate": "MUSE_NO_AUTO_UPDATE=1 muse plugins validate plugin --json",
    "test:live": "node scripts/live-poc.mjs",
    "release:build": "node scripts/build-release.mjs",
    "release:upload": "node scripts/publish-release.mjs",
    "release:promote": "node scripts/publish-release.mjs --promote",
    "pretest": "npm run plugin:build",
    "precheck": "npm run plugin:build",
    "preplugin:validate": "npm run plugin:build",
    "pretest:codeql": "npm run plugin:build",
    "pretest:live": "npm run plugin:build",
    "test:policy": "node scripts/policy-smoke.mjs",
    "pretest:policy": "npm run plugin:build",
    "release:github": "node scripts/github-release.mjs"
  },
  "dependencies": {
    "openai": "7.45.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  },
  "license": "Apache-2.0",
  "homepage": "https://bypasslabs.ai",
  "repository": {
    "type": "git",
    "url": "https://github.com/Bypass-Labs/bypass.git"
  }
}
